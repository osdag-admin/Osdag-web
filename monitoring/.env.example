# Add these to the server's .env (the same file used by docker-compose.prod.yml).
# DATABASE_NAME / DATABASE_USER / DATABASE_PASSWORD are reused from there.

# Grafana (required). Bound to 127.0.0.1 only; use an SSH tunnel or VPN.
GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_ADMIN_USER=admin
# GRAFANA_PORT=3000
# GRAFANA_ROOT_URL=http://localhost:3000

# Docker network of the app stack: "<compose project>_default" (see `docker network ls`).
# APP_NETWORK=osdag-web_default

# Alerts via Telegram: create a bot with @BotFather, send it a message, then read
# the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates (negative for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional error tracking (works with sentry.io or self-hosted GlitchTip).
# Backend reads this at runtime (add to the backend/celery env in the prod compose file);
# the frontend value must be passed as a build arg (VITE_SENTRY_DSN) when building the image.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
