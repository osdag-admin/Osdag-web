# Copy this file to `.env` in the repository root and fill in real values.
# `.env` is git-ignored and must never be committed.
#
# Docker Compose reads this file automatically. For native development, the
# service hostnames below (`db`, `redis`) should be `localhost` instead.

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL ---
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=postgres_Intg_osdag
DATABASE_USER=osdagdeveloper
DATABASE_PASSWORD=change-me

# --- Redis / Celery ---
# Required by docker-compose.prod.yml, which starts Redis with this password.
# The dev compose file runs Redis without one.
REDIS_PASSWORD=change-me
USE_REDIS_CACHE=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- InfluxDB (load-test metrics) ---
INFLUXDB_TOKEN=change-me
INFLUXDB_ADMIN_PASSWORD=change-me

# --- Grafana (load-test dashboards) ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Optional (see docker-compose.yml and backend/config/settings for defaults) ---
# DB_HOST_PORT=5433
# HOST_UID=1000
# HOST_GID=1000
# SMTP_HOST=
# SMTP_PORT=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
